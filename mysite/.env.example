# Copy this file to ".env" and fill in your real values.
# ".env" is private and is ignored by git. ".env.example" is safe to upload.
SECRET_KEY=put_a_long_random_string_here
NEWSDATA_API_KEY=your_newsdata_io_api_key
ADMIN_PASSWORD=choose_a_strong_admin_password
FLASK_DEBUG=0
CRON_TOKEN=put_another_long_random_string_here

# Push notifications (VAPID keys). Generate once, never change them later
# (changing them logs out every subscribed phone). Optional: if missing, push is simply switched off.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
